---
import AdminLayout from '../../layouts/AdminLayout.astro';
import DashboardComp from '../../components/admin/Dashboard.astro';
---

<AdminLayout title="Dashboard">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="w-64 bg-[var(--bg-secondary)] border-r border-[var(--border)] p-6 hidden md:block">
      <div class="flex items-center gap-2 mb-8">
        <div class="w-8 h-8 rounded-lg bg-[var(--primary)] flex items-center justify-center">
          <span class="text-white font-bold text-sm">V</span>
        </div>
        <span class="font-bold text-[var(--text)]">Vectra Admin</span>
      </div>

      <nav class="space-y-1">
        {[
          { href: '/admin/dashboard', label: 'Dashboard', icon: 'grid' },
          { href: '/admin/products', label: 'Productos', icon: 'box' },
          { href: '/admin/blog', label: 'Blog', icon: 'file-text' },
          { href: '/admin/settings', label: 'Configuración', icon: 'settings' },
        ].map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors',
              Astro.url.pathname === href
                ? 'bg-[var(--primary)] text-white'
                : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-card)]',
            ]}
          >
            {label}
          </a>
        ))}
      </nav>

      <div class="mt-auto pt-8">
        <a href="/es" class="flex items-center gap-2 text-sm text-[var(--text-muted)] hover:text-[var(--primary)] transition-colors">
          ← Ver sitio
        </a>
      </div>
    </aside>

    <!-- Main content -->
    <main class="flex-1 p-8">
      <DashboardComp />
    </main>
  </div>
</AdminLayout>

<script>
  import { initAuth, authStore } from '../../stores/auth';
  initAuth();
  authStore.subscribe((state) => {
    if (!state.isAuthenticated) {
      window.location.href = '/admin';
    }
  });
</script>
