---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/admin/AdminSidebar.astro';
import UsersCRUD from '../../components/admin/UsersCRUD';
---

<AdminLayout title="👥 Usuarios">
  <div class="flex min-h-screen">
    <AdminSidebar />
    <main class="flex-1 p-4 sm:p-6 md:p-8 pt-16 md:pt-8 pb-24 md:pb-8 min-w-0">
      <UsersCRUD client:only="react" />
    </main>
  </div>
</AdminLayout>

<script>
  import { initAuth, authStore } from '../../stores/auth';
  initAuth();
  authStore.subscribe((state) => { if (!state.isAuthenticated || state.role !== 'admin') window.location.href = '/admin'; });
</script>
