---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogList from '../../../components/blog/BlogList.astro';
import { useTranslations, type Lang } from '../../../i18n/ui';
import type { ApiPost } from '../../../types/api';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000';
let apiPosts: ApiPost[] = [];
try {
  const res = await fetch(`${apiUrl}/api/v1/blog?limit=50`);
  if (res.ok) apiPosts = (await res.json()).data ?? [];
} catch (e) {
  console.error('[blog/index] API failed:', e);
}

// Transformar al formato que espera BlogList (sin modificar ese componente)
const posts = apiPosts
  .filter((p) => !p.draft)
  .sort((a, b) => new Date(b.publishedAt ?? b.createdAt).getTime() - new Date(a.publishedAt ?? a.createdAt).getTime())
  .map((p) => ({
    id: p.slug,
    data: {
      title: lang === 'es' ? p.titleEs : p.titleEn,
      excerpt: lang === 'es' ? p.excerptEs : p.excerptEn,
      date: new Date(p.publishedAt ?? p.createdAt),
      author: p.author,
      coverImage: p.coverImage,
      tags: p.tags.map((t) => (lang === 'es' ? t.tag.nameEs : t.tag.nameEn)),
    },
  }));
---

<BaseLayout
  title={t('blog.title')}
  description={t('blog.subtitle')}
  lang={lang}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-[var(--text)] mb-2">{t('blog.title')}</h1>
      <p class="text-[var(--text-muted)]">{t('blog.subtitle')}</p>
    </div>
    <BlogList lang={lang} posts={posts} />
  </div>
</BaseLayout>
