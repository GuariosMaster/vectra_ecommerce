---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (post) => !post.data.draft);
  return ['es', 'en'].flatMap((lang) =>
    posts.map((post) => ({
      params: { lang, slug: post.id },
      props: { post },
    }))
  );
}

type BlogEntry = Awaited<ReturnType<typeof getCollection<'blog'>>>[number];
const { post } = Astro.props as { post: BlogEntry };
const { Content } = await render(post);
const { title, excerpt, date, author, coverImage, tags, readingTime } = post.data;
---

<BlogLayout
  title={title}
  description={excerpt ?? title}
  date={date}
  author={author}
  coverImage={coverImage}
  tags={tags}
>
  <Content />
</BlogLayout>
