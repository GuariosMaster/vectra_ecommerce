---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { type Lang } from '../../../i18n/ui';
import type { ApiPost } from '../../../types/api';

export async function getStaticPaths() {
  const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000';
  let apiPosts: ApiPost[] = [];
  try {
    const res = await fetch(`${apiUrl}/api/v1/blog?limit=200`);
    if (res.ok) apiPosts = (await res.json()).data ?? [];
  } catch (e) {
    console.error('[blog/slug] getStaticPaths failed:', e);
  }

  // Solo posts publicados generan rutas estáticas
  const published = apiPosts.filter((p) => !p.draft);

  return ['es', 'en'].flatMap((lang) =>
    published.map((post) => ({
      params: { lang, slug: post.slug },
      props: { post, lang },
    }))
  );
}

type Props = { post: ApiPost; lang: Lang };
const { post, lang } = Astro.props;

const title = lang === 'es' ? post.titleEs : post.titleEn;
const excerpt = lang === 'es' ? post.excerptEs : post.excerptEn;
const content = lang === 'es' ? post.contentEs : post.contentEn;
const tags = post.tags.map((t) => (lang === 'es' ? t.tag.nameEs : t.tag.nameEn));
const date = new Date(post.publishedAt ?? post.createdAt);
---

<BlogLayout
  title={title}
  description={excerpt}
  date={date}
  author={post.author}
  coverImage={post.coverImage}
  tags={tags}
>
  <p style="white-space: pre-line">{content}</p>
</BlogLayout>
