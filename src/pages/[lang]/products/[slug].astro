---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductDetailView from '../../../components/products/ProductDetailView';
import ShoppingCart from '../../../components/products/ShoppingCart';
import { type Lang } from '../../../i18n/ui';
import type { ApiProduct } from '../../../types/api';

export async function getStaticPaths() {
  const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000';
  let apiProducts: ApiProduct[] = [];
  try {
    const res = await fetch(`${apiUrl}/api/v1/products?limit=200`);
    if (res.ok) apiProducts = (await res.json()).data ?? [];
  } catch (e) {
    console.error('[slug] getStaticPaths failed:', e);
  }

  return ['es', 'en'].flatMap((lang) =>
    apiProducts.map((product) => ({
      params: { lang, slug: product.slug },
      props: { lang },
    }))
  );
}

type Props = { lang: Lang };
const { slug } = Astro.params;
const { lang } = Astro.props as Props;
---

<BaseLayout title={slug} lang={lang}>
  <ProductDetailView client:only="react" slug={slug} lang={lang} />
  <ShoppingCart lang={lang} client:only="react" />
</BaseLayout>
