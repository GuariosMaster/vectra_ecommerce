---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  excerpt: string;
  date: Date;
  author: string;
  coverImage: string;
  tags?: string[];
  readingTime?: number;
}

const { lang, slug, title, excerpt, date, author, coverImage, tags = [], readingTime } = Astro.props;
const t = useTranslations(lang);

const dateFormatted = date.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group bg-[var(--bg-card)] border border-[var(--border)] rounded-2xl overflow-hidden
                hover:border-[var(--primary)] hover:shadow-xl hover:-translate-y-1
                transition-all duration-300 flex flex-col">

  <!-- Cover -->
  <a href={`/${lang}/blog/${slug}`} class="block overflow-hidden aspect-video bg-[var(--bg-secondary)]">
    <img
      src={coverImage}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
  </a>

  <!-- Body -->
  <div class="p-6 flex flex-col flex-1">
    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.slice(0, 2).map((tag) => (
          <span class="text-xs font-medium px-2 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)]">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Title -->
    <a href={`/${lang}/blog/${slug}`} class="hover:text-[var(--primary)] transition-colors">
      <h3 class="font-semibold text-[var(--text)] text-lg mb-2 line-clamp-2">{title}</h3>
    </a>

    <p class="text-[var(--text-muted)] text-sm line-clamp-3 mb-4 flex-1">{excerpt}</p>

    <!-- Meta -->
    <div class="flex items-center justify-between text-xs text-[var(--text-muted)] mt-auto">
      <span>{t('blog.by')} {author}</span>
      <div class="flex items-center gap-3">
        {readingTime && <span>{readingTime} {t('blog.min')}</span>}
        <time datetime={date.toISOString()}>{dateFormatted}</time>
      </div>
    </div>
  </div>
</article>
