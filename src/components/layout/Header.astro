---
import ThemeToggle from './ThemeToggle';
import LangSwitch from './LangSwitch.astro';
import UserMenu from './UserMenu';
import Logo from './Logo.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { href: `/${lang}`,                 label: t('nav.home') },
  { href: `/${lang}/products`,        label: t('nav.products') },
  { href: `/${lang}/blog`,            label: t('nav.blog') },
  { href: `/${lang}/personalization`, label: t('nav.personalization') },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--bg)]/85 backdrop-blur-md"
  style="box-shadow: 0 1px 0 var(--border), 0 4px 30px rgba(0,0,0,0.15);"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">

      <!-- ── Logo ── -->
      <Logo lang={lang} />

      <!-- ── Desktop Nav ── -->
      <nav class="hidden md:flex items-center gap-0.5 flex-1 justify-center" aria-label="Main navigation">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath === href || (href !== `/${lang}` && currentPath.startsWith(href));
          return (
            <a
              href={href}
              class:list={[
                'relative px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200',
                isActive
                  ? 'text-white'
                  : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-secondary)]',
              ]}
              style={isActive
                ? 'background: linear-gradient(135deg, var(--accent), var(--primary)); box-shadow: 0 0 14px var(--glow-weak);'
                : ''}
            >
              {label}
            </a>
          );
        })}
      </nav>

      <!-- ── Right actions ── -->
      <div class="flex items-center gap-1.5 flex-shrink-0">

        <!-- Cart button -->
        <button
          id="cart-btn"
          aria-label={t('nav.cart')}
          class="relative w-10 h-10 flex items-center justify-center rounded-xl
                 border border-transparent hover:border-[var(--primary)]/40
                 hover:bg-[var(--primary)]/8 transition-all duration-200
                 text-[var(--text-muted)] hover:text-[var(--primary)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <!-- Badge contador -->
          <span
            id="cart-count"
            class="absolute -top-1 -right-1 w-5 h-5 rounded-full text-white
                   text-[10px] font-black flex items-center justify-center hidden"
            style="background: var(--primary); box-shadow: 0 0 8px var(--glow);"
          >0</span>
        </button>

        <!-- Lang switch — oculto bajo 380px (se muestra en el menú hamburguesa) -->
        <div class="hidden min-[380px]:block">
          <LangSwitch lang={lang} />
        </div>

        <!-- Theme toggle -->
        <ThemeToggle client:only="react" />

        <!-- User menu — oculto bajo 450px (aparece en el menú hamburguesa) -->
        <div class="hidden min-[450px]:block">
          <UserMenu lang={lang} client:only="react" />
        </div>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          aria-label="Toggle menu"
          class="md:hidden w-10 h-10 flex items-center justify-center rounded-xl
                 hover:bg-[var(--bg-secondary)] transition-colors duration-200
                 text-[var(--text-muted)] hover:text-[var(--text)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6"  x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- ── Mobile Nav ── -->
    <nav id="mobile-menu" class="md:hidden hidden pb-4 pt-1" aria-label="Mobile navigation">
      <div class="flex flex-col gap-1">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath === href || (href !== `/${lang}` && currentPath.startsWith(href));
          return (
            <a
              href={href}
              class:list={[
                'px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200',
                isActive
                  ? 'text-white'
                  : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-secondary)]',
              ]}
              style={isActive ? 'background: linear-gradient(135deg, var(--accent), var(--primary)); box-shadow: 0 0 12px var(--glow-weak);' : ''}
            >
              {label}
            </a>
          );
        })}

        <!-- Cart mobile row -->
        <button
          id="cart-btn-mobile"
          class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium
                 text-[var(--text-muted)] hover:text-[var(--primary)] hover:bg-[var(--bg-secondary)]
                 transition-all duration-200 text-left"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          {t('nav.cart')}
          <span id="cart-count-mobile" class="ml-auto px-2 py-0.5 rounded-full text-xs font-bold hidden"
                style="background: var(--primary); color: white;">0</span>
        </button>

        <!-- Cambio de idioma en menú — solo visible bajo 380px (cuando está oculto de la barra) -->
        <div class="min-[380px]:hidden border-t border-[var(--border)] pt-2 mt-1">
          <LangSwitch lang={lang} />
        </div>

        <!-- Login en menú hamburguesa — solo visible bajo 450px -->
        <div class="min-[450px]:hidden border-t border-[var(--border)] pt-2 mt-1">
          <UserMenu lang={lang} menuMode={true} client:only="react" />
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  import { cartCount, cartOpen } from '../../stores/cart';

  // Desktop cart button
  const cartBtn        = document.getElementById('cart-btn');
  const countEl        = document.getElementById('cart-count');

  // Mobile cart button
  const cartBtnMobile  = document.getElementById('cart-btn-mobile');
  const countMobile    = document.getElementById('cart-count-mobile');

  cartCount.subscribe((n) => {
    const hidden = n === 0;

    if (countEl)     { countEl.textContent = String(n);    countEl.classList.toggle('hidden', hidden); }
    if (countMobile) { countMobile.textContent = String(n); countMobile.classList.toggle('hidden', hidden); }
  });

  function toggleCart() { cartOpen.set(!cartOpen.get()); }
  cartBtn?.addEventListener('click', toggleCart);
  cartBtnMobile?.addEventListener('click', toggleCart);

  // Mobile menu toggle
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
