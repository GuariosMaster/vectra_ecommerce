---
import { languages, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Build the alternate URL by replacing the current lang segment
function getAlternateLang(currentLang: Lang): { lang: Lang; href: string } {
  const altLang = currentLang === 'es' ? 'en' : 'es';
  const currentPath = Astro.url.pathname;
  const newPath = currentPath.replace(`/${currentLang}`, `/${altLang}`);
  return { lang: altLang, href: newPath };
}

const alternate = getAlternateLang(lang);
---

<a
  href={alternate.href}
  class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium
         text-[var(--text-muted)] hover:text-[var(--text)]
         hover:bg-[var(--bg-secondary)] transition-colors duration-200"
  aria-label={`Switch to ${languages[alternate.lang]}`}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"/>
    <line x1="2" y1="12" x2="22" y2="12"/>
    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
  </svg>
  <span>{alternate.lang.toUpperCase()}</span>
</a>
