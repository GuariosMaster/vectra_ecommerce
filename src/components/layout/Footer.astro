---
import { useTranslations, type Lang } from '../../i18n/ui';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-auto relative overflow-hidden"
        style="border-top: 1px solid var(--border); background: var(--bg-secondary);">
  <!-- Subtle dual glow at the top edge -->
  <div class="absolute top-0 left-1/4 w-[300px] h-[1px] pointer-events-none"
       style="background: linear-gradient(to right, transparent, var(--accent), transparent); opacity: 0.4;"></div>
  <div class="absolute top-0 right-1/4 w-[300px] h-[1px] pointer-events-none"
       style="background: linear-gradient(to right, transparent, var(--primary), transparent); opacity: 0.3;"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <!-- Brand -->
      <div>
        <div class="mb-3">
          <Logo lang={lang} size="sm" />
        </div>
        <p class="text-[var(--text-muted)] text-sm">{t('footer.tagline')}</p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-semibold text-[var(--text)] mb-3 flex items-center gap-2">
          <span class="w-3 h-0.5 rounded-full" style="background: var(--primary);"></span>
          {t('footer.links')}
        </h3>
        <ul class="space-y-2">
          <li><a href={`/${lang}`}               class="text-sm text-[var(--text-muted)] hover:text-[var(--primary)] transition-colors">{t('nav.home')}</a></li>
          <li><a href={`/${lang}/products`}       class="text-sm text-[var(--text-muted)] hover:text-[var(--primary)] transition-colors">{t('nav.products')}</a></li>
          <li><a href={`/${lang}/blog`}           class="text-sm text-[var(--text-muted)] hover:text-[var(--primary)] transition-colors">{t('nav.blog')}</a></li>
          <li><a href={`/${lang}/personalization`}class="text-sm text-[var(--text-muted)] hover:text-[var(--primary)] transition-colors">{t('nav.personalization')}</a></li>
        </ul>
      </div>

      <!-- Contact — blue icons -->
      <div>
        <h3 class="font-semibold text-[var(--text)] mb-3 flex items-center gap-2">
          <span class="w-3 h-0.5 rounded-full" style="background: var(--accent);"></span>
          {t('footer.contact')}
        </h3>
        <ul class="space-y-2">
          <li>
            <a
              href={import.meta.env.PUBLIC_WHATSAPP_URL || `https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER || ''}`}
              class="text-sm text-[var(--text-muted)] transition-colors flex items-center gap-2"
              target="_blank"
              rel="noopener"
              onmouseover="this.style.color='var(--accent)'"
              onmouseout="this.style.color=''"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"
                   style="color: var(--accent); opacity: 0.8;">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.116.554 4.1 1.524 5.82L.057 23.998l6.304-1.644A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.817 9.817 0 0 1-5.001-1.368l-.359-.214-3.72.97.994-3.62-.235-.372A9.79 9.79 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
              </svg>
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href={`mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL || 'contacto@vectra.com'}`}
              class="text-sm text-[var(--text-muted)] transition-colors flex items-center gap-2"
              onmouseover="this.style.color='var(--accent)'"
              onmouseout="this.style.color=''"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                   style="color: var(--accent); opacity: 0.8;">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              Email
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Social Media Icons Row -->
    <div class="mt-8 pt-6 relative">
      <div class="absolute top-0 left-0 right-0 h-px"
           style="background: linear-gradient(to right, transparent, var(--border), transparent);"></div>
      <div class="flex items-center justify-center gap-4">

        <!-- Facebook -->
        <a href={import.meta.env.PUBLIC_FACEBOOK_URL} target="_blank" rel="noopener"
           class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-200"
           style="background: var(--bg-card); border: 1px solid var(--border);"
           onmouseover="this.style.borderColor='#1877F2'; this.style.background='rgba(24,119,242,0.12)';"
           onmouseout="this.style.borderColor='var(--border)'; this.style.background='var(--bg-card)';"
           title="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#1877F2">
            <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.313 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.268h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
          </svg>
        </a>

        <!-- Instagram -->
        <a href={import.meta.env.PUBLIC_INSTAGRAM_URL} target="_blank" rel="noopener"
           class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-200"
           style="background: var(--bg-card); border: 1px solid var(--border);"
           onmouseover="this.style.borderColor='#E1306C'; this.style.background='rgba(225,48,108,0.12)';"
           onmouseout="this.style.borderColor='var(--border)'; this.style.background='var(--bg-card)';"
           title="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="url(#ig-grad)">
            <defs>
              <linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#F58529"/>
                <stop offset="50%" stop-color="#E1306C"/>
                <stop offset="100%" stop-color="#833AB4"/>
              </linearGradient>
            </defs>
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
          </svg>
        </a>

        <!-- WhatsApp -->
        <a href={import.meta.env.PUBLIC_WHATSAPP_URL} target="_blank" rel="noopener"
           class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-200"
           style="background: var(--bg-card); border: 1px solid var(--border);"
           onmouseover="this.style.borderColor='#25D366'; this.style.background='rgba(37,211,102,0.12)';"
           onmouseout="this.style.borderColor='var(--border)'; this.style.background='var(--bg-card)';"
           title="WhatsApp">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#25D366">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.116.554 4.1 1.524 5.82L.057 23.998l6.304-1.644A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.817 9.817 0 0 1-5.001-1.368l-.359-.214-3.72.97.994-3.62-.235-.372A9.79 9.79 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
          </svg>
        </a>

        <!-- TikTok -->
        <a href={import.meta.env.PUBLIC_TIKTOK_URL} target="_blank" rel="noopener"
           class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-200"
           style="background: var(--bg-card); border: 1px solid var(--border);"
           onmouseover="this.style.borderColor='#ffffff'; this.style.background='rgba(255,255,255,0.1)';"
           onmouseout="this.style.borderColor='var(--border)'; this.style.background='var(--bg-card)';"
           title="TikTok">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"
               style="color: var(--text);">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.27 8.27 0 0 0 4.83 1.55V6.79a4.85 4.85 0 0 1-1.06-.1z"/>
          </svg>
        </a>

      </div>
    </div>

    <!-- Bottom bar — gradient separator line -->
    <div class="mt-6 pt-6 text-center text-sm text-[var(--text-muted)] relative">
      <div class="absolute top-0 left-0 right-0 h-px"
           style="background: linear-gradient(to right, transparent, var(--accent), var(--primary), transparent); opacity: 0.3;"></div>
      <p>&copy; {year} Vectra. {t('footer.rights')}.</p>
    </div>
  </div>
</footer>
