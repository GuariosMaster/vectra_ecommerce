---
const waUrl = import.meta.env.PUBLIC_WHATSAPP_URL || 'https://wa.me/573045663159';
---

<!-- WhatsApp Floating Button -->
<div id="wa-float" class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-2">

  <!-- Tooltip bubble -->
  <div
    id="wa-bubble"
    class="wa-bubble flex items-center gap-2 px-3 py-2 rounded-xl rounded-br-sm shadow-xl text-xs font-medium select-none"
    style="
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text);
      opacity: 0;
      transform: translateY(8px) scale(0.95);
      transform-origin: bottom right;
      transition: opacity 0.25s ease, transform 0.25s ease;
      pointer-events: none;
      white-space: nowrap;
    "
  >
    <!-- WhatsApp dot indicator -->
    <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background: #25D366;"></span>
    <span>¿Necesitas ayuda? <strong>Contáctanos</strong></span>
    <!-- Close X -->
    <button
      id="wa-close"
      class="ml-1 opacity-50 hover:opacity-100 transition-opacity text-xs leading-none"
      style="color: var(--text-muted);"
      aria-label="Cerrar"
    >✕</button>
  </div>

  <!-- Main button -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    id="wa-btn"
    aria-label="Contáctanos por WhatsApp"
    class="relative w-11 h-11 rounded-full flex items-center justify-center shadow-lg"
    style="background: #25D366; transition: transform 0.2s ease, box-shadow 0.2s ease;"
    onmouseover="this.style.transform='scale(1.1)'; this.style.boxShadow='0 8px 30px rgba(37,211,102,0.45)';"
    onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='';"
  >
    <!-- Pulse ring -->
    <span
      class="absolute inset-0 rounded-full"
      style="background: #25D366; animation: wa-pulse 2.5s ease-out infinite; opacity: 0.5;"
    ></span>
    <!-- WhatsApp SVG -->
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="white" class="relative z-10">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.116.554 4.1 1.524 5.82L.057 23.998l6.304-1.644A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.817 9.817 0 0 1-5.001-1.368l-.359-.214-3.72.97.994-3.62-.235-.372A9.79 9.79 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
    </svg>
  </a>
</div>

<style>
  @keyframes wa-pulse {
    0%   { transform: scale(1);   opacity: 0.5; }
    70%  { transform: scale(1.6); opacity: 0;   }
    100% { transform: scale(1.6); opacity: 0;   }
  }
</style>

<script is:inline>
  (function () {
    const bubble  = document.getElementById('wa-bubble');
    const closeBtn = document.getElementById('wa-close');
    let dismissed = false;
    let shown     = false;

    function showBubble() {
      if (dismissed || shown) return;
      shown = true;
      bubble.style.opacity = '1';
      bubble.style.transform = 'translateY(0) scale(1)';
      bubble.style.pointerEvents = 'auto';
    }

    function hideBubble() {
      shown = false;
      bubble.style.opacity = '0';
      bubble.style.transform = 'translateY(8px) scale(0.95)';
      bubble.style.pointerEvents = 'none';
    }

    // Show bubble after 3 seconds automatically
    setTimeout(showBubble, 3000);

    // Close button dismisses permanently
    closeBtn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      dismissed = true;
      hideBubble();
    });

    // Toggle on button click (mobile friendly)
    document.getElementById('wa-btn').addEventListener('click', function (e) {
      if (shown) {
        // Let the link open normally, just hide bubble
        hideBubble();
      }
    });
  })();
</script>
