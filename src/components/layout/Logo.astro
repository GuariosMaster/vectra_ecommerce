---
interface Props {
  lang: string;
  size?: 'sm' | 'md';
}
const { lang, size = 'md' } = Astro.props;
const px = size === 'sm' ? 41 : 51;
---

<a
  href={`/${lang}`}
  class="vectra-logo group inline-flex items-center gap-2.5 flex-shrink-0 select-none outline-none"
  aria-label="Vectra home"
>
  <!-- Logo image -->
  <div class="vectra-logo__icon relative flex-shrink-0">
    <div class="vectra-logo__border" style={`width:${px}px; height:${px}px;`}>
      <img
        src="/images/vectra_logo6.png"
        alt="Vectra logo"
        width={px}
        height={px}
        style="object-fit: contain; width:100%; height:100%; display:block;"
      />
    </div>
  </div>

  <!-- VECTRA wordmark -->
  <div class="vectra-logo__word uppercase"
       style={`font-family: 'Orbitron', sans-serif; font-weight: 900; letter-spacing: 0.1em; font-size: ${size === 'sm' ? '0.9rem' : '1.05rem'}; color: var(--text);`}>
    <span style="color: #00aaff;">VEC</span><span style="color: var(--primary);">TRA</span>
  </div>
</a>

<style>
  /* ── Borde neon fucsia ── */
  .vectra-logo__border {
    border-radius: 12px;
    border: 1.5px solid #e800ff;
    padding: 4px;
    box-shadow:
      0 0 4px #e800ff55,
      0 0 8px #e800ff22;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  @keyframes vl-border-pulse {
    0%, 100% {
      box-shadow:
        0 0 4px #e800ff88,
        0 0 12px #e800ff33,
        inset 0 0 4px #e800ff11;
    }
    50% {
      box-shadow:
        0 0 8px #e800ffcc,
        0 0 22px #e800ff66,
        0 0 40px #e800ff22,
        inset 0 0 8px #e800ff33;
    }
  }

  /* ── Idle: drop-shadow suave en la imagen ── */
  .vectra-logo__icon {
    transition: transform 0.25s ease;
  }

  /* ── Hover: borde y glow más intensos ── */
  .vectra-logo:hover .vectra-logo__border,
  .vectra-logo:focus-visible .vectra-logo__border {
    transform: scale(1.06) translateY(-1px);
    animation: vl-border-pulse 1.2s ease-in-out infinite;
  }

  /* ── Hover: shimmer sweep across wordmark ── */
  .vectra-logo__word {
    position: relative;
    overflow: hidden;
  }

  .vectra-logo:hover .vectra-logo__word::after,
  .vectra-logo:focus-visible .vectra-logo__word::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 0%,
      rgba(255, 255, 255, 0.1) 40%,
      rgba(255, 255, 255, 0.06) 55%,
      transparent 100%
    );
    animation: vl-shimmer 0.55s ease-out forwards;
  }

  @keyframes vl-shimmer {
    from { transform: translateX(-120%); }
    to   { transform: translateX(200%);  }
  }
</style>
