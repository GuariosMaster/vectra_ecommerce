---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-20 bg-[var(--bg)] relative overflow-hidden">
  <!-- Background glow -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-[800px] h-[300px] rounded-full bg-[var(--primary)] opacity-5 blur-[100px]"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="p-12 rounded-3xl bg-[var(--bg-card)] border border-[var(--border)]
                shadow-2xl">
      <h2 class="text-3xl md:text-5xl font-black text-[var(--text)] mb-4">
        {t('cta.title')}
      </h2>
      <p class="text-[var(--text-muted)] text-lg mb-8 max-w-lg mx-auto">
        {t('cta.subtitle')}
      </p>
      <a
        href={`/${lang}/personalization`}
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl font-semibold text-white
               bg-[var(--primary)] hover:bg-[var(--primary-hover)]
               transition-all duration-200 hover:scale-105 hover:shadow-lg
               shadow-[0_0_40px_rgba(59,130,246,0.4)] text-lg"
      >
        {t('cta.button')}
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</section>
