---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden bg-[var(--bg)] min-h-[90vh] flex items-center">
  <!-- Background grid pattern -->
  <div class="absolute inset-0 opacity-5 dark:opacity-10"
    style="background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px); background-size: 40px 40px;">
  </div>

  <!-- Glow effect -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px]
              rounded-full bg-[var(--primary)] opacity-10 blur-[120px] pointer-events-none">
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Content -->
      <div class="text-center lg:text-left">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full
                    bg-[var(--bg-card)] border border-[var(--border)] text-sm
                    text-[var(--primary)] font-medium mb-6 animate-fade-in">
          <div class="w-2 h-2 rounded-full bg-[var(--primary)] animate-pulse"></div>
          {t('hero.badge')}
        </div>

        <!-- Headline -->
        <h1 class="text-5xl lg:text-7xl font-black text-[var(--text)] leading-tight mb-6">
          {t('hero.title')}<br />
          <span class="text-transparent bg-clip-text"
            style="background-image: linear-gradient(135deg, var(--primary), #8b5cf6)">
            {t('hero.titleHighlight')}
          </span>
        </h1>

        <p class="text-lg text-[var(--text-muted)] mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed">
          {t('hero.subtitle')}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href={`/${lang}/products`}
            class="px-8 py-4 rounded-xl font-semibold text-white
                   bg-[var(--primary)] hover:bg-[var(--primary-hover)]
                   transition-all duration-200 hover:scale-105 hover:shadow-lg
                   shadow-[0_0_30px_rgba(59,130,246,0.3)]"
          >
            {t('hero.ctaPrimary')}
          </a>
          <a
            href={`/${lang}/personalization`}
            class="px-8 py-4 rounded-xl font-semibold
                   border border-[var(--border)] text-[var(--text)]
                   hover:bg-[var(--bg-secondary)] hover:border-[var(--primary)]
                   transition-all duration-200"
          >
            {t('hero.ctaSecondary')} →
          </a>
        </div>

        <!-- Stats -->
        <div class="mt-12 flex gap-8 justify-center lg:justify-start">
          {[
            { value: '500+', label: lang === 'es' ? 'Proyectos' : 'Projects' },
            { value: '98%', label: lang === 'es' ? 'Satisfacción' : 'Satisfaction' },
            { value: '48h', label: lang === 'es' ? 'Entrega media' : 'Avg delivery' },
          ].map(({ value, label }) => (
            <div class="text-center">
              <div class="text-2xl font-black text-[var(--text)]">{value}</div>
              <div class="text-xs text-[var(--text-muted)] mt-1">{label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Visual -->
      <div class="relative flex justify-center">
        <div class="relative w-full max-w-md">
          <!-- Main card -->
          <div class="rounded-3xl bg-[var(--bg-card)] border border-[var(--border)]
                      p-8 shadow-2xl hover:scale-[1.02] transition-transform duration-500">
            <!-- 3D print visualization placeholder -->
            <div class="aspect-square rounded-2xl bg-gradient-to-br from-[var(--primary)] to-purple-600
                        opacity-20 flex items-center justify-center mb-6">
            </div>
            <div class="aspect-square rounded-2xl overflow-hidden bg-[var(--bg-secondary)]
                        flex items-center justify-center -mt-[calc(100%+1.5rem+2px)] relative z-10">
              <div class="text-center p-8">
                <div class="w-24 h-24 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-[var(--primary)] to-purple-600
                            flex items-center justify-center shadow-lg">
                  <!-- 3D cube icon -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
                  </svg>
                </div>
                <p class="text-[var(--text)] font-semibold text-lg">Impresión 3D</p>
                <p class="text-[var(--text-muted)] text-sm mt-1">Precision &amp; Quality</p>
              </div>
            </div>
          </div>

          <!-- Floating badges -->
          <div class="absolute -top-4 -right-4 px-3 py-2 rounded-xl bg-green-500/20
                      border border-green-500/40 text-green-400 text-xs font-semibold backdrop-blur-sm">
            ✓ {lang === 'es' ? 'Alta calidad' : 'High quality'}
          </div>
          <div class="absolute -bottom-4 -left-4 px-3 py-2 rounded-xl bg-[var(--primary)]/20
                      border border-[var(--primary)]/40 text-[var(--primary)] text-xs font-semibold backdrop-blur-sm">
            ⚡ {lang === 'es' ? 'Entrega rápida' : 'Fast delivery'}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
@keyframes fade-in {
  from { opacity: 0; transform: translateY(-8px); }
  to   { opacity: 1; transform: translateY(0); }
}
.animate-fade-in { animation: fade-in 0.6s ease both; }
</style>
