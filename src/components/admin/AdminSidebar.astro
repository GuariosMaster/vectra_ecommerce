---
import ThemeToggle from '../layout/ThemeToggle';
import Logo from '../layout/Logo.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  {
    href: '/admin/dashboard',
    label: 'Dashboard',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
  },
  {
    href: '/admin/products',
    label: 'Productos',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>`,
  },
  {
    href: '/admin/blog',
    label: 'Blog',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    href: '/admin/categories',
    label: 'Categorías',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    href: '/admin/orders',
    label: 'Pedidos',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
  },
  {
    href: '/admin/users',
    label: 'Usuarios',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    href: '/admin/personalization',
    label: 'Personaliz.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
  },
  {
    href: '/admin/settings',
    label: 'Configuración',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M6.34 17.66l-1.41 1.41M2 12h2M20 12h2M19.07 19.07l-1.41-1.41M6.34 6.34L4.93 4.93M12 2v2M12 20v2"/></svg>`,
  },
];
---

<!-- Desktop sidebar only — mobile nav is handled by AdminLayout -->
<aside class="w-64 bg-[var(--bg-secondary)] border-r border-[var(--border)] p-5
              hidden md:flex flex-col min-h-screen flex-shrink-0">

  <!-- Logo -->
  <div class="mb-8">
    <Logo lang="es" size="sm" />
    <p class="text-[10px] font-medium tracking-[0.2em] uppercase mt-2 ml-0.5"
       style="color: var(--text-muted);">
      Panel de control
    </p>
  </div>

  <!-- Nav -->
  <nav class="flex-1 space-y-0.5">
    {navItems.map(({ href, label, icon }) => {
      const isActive = currentPath === href;
      return (
        <a
          href={href}
          class:list={[
            'flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200',
            isActive
              ? 'text-white'
              : 'text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-card)]',
          ]}
          style={isActive
            ? 'background: linear-gradient(135deg, var(--accent), var(--primary)); box-shadow: 0 0 12px var(--glow-weak);'
            : ''}
        >
          <span set:html={icon} />
          {label}
        </a>
      );
    })}
  </nav>

  <!-- Bottom bar -->
  <div class="pt-4 border-t border-[var(--border)]">
    <div class="flex items-center justify-between">
      <a
        href="/es"
        class="flex items-center gap-1.5 text-sm transition-colors"
        style="color: var(--text-muted);"
        onmouseover="this.style.color='var(--primary)'"
        onmouseout="this.style.color='var(--text-muted)'"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Ver sitio
      </a>
      <ThemeToggle client:only="react" />
    </div>
  </div>
</aside>
